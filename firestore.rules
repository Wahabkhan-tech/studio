/**
 * Core Philosophy: This ruleset implements a sophisticated Role-Based Access Control (RBAC) model
 * tailored for an educational platform. It uses dedicated collections (`/roles_admin`, `/roles_teacher`,
 * `/roles_student`) to manage user privileges. The core principle is "deny by default," granting
 * access only to authenticated users based on their specific role and their relationship to the data
 * (e.g., membership in a group).
 *
 * Data Structure: The structure is centered around a top-level `/groups` collection. All project-specific
 * data, such as proposals, tasks, and attendance, are organized in subcollections under each group.
 * This hierarchical model allows for granular control, where access to subcollection documents is
 * inherited from membership in the parent group. Chat functionality is segregated by context into
 * `/global_chat`, `/group_chats`, and `/session_chats` to enforce different access policies for each.
 *
 * Key Security Decisions:
 * - Denormalization for Authorization: To ensure fast and secure access checks, critical authorization
 *   data is denormalized. Specifically, each document in `/groups` contains a `teacherId` and a
 *   `memberIds` array. This allows rules to verify a user's role within a group without performing
 *   costly and slow cross-collection `get()` calls.
 * - Structural Segregation: Chat systems are separated into distinct top-level collections
 *   (`/global_chat`, `/group_chats`, `/session_chats`). This prevents data leakage and simplifies
 *   rules, as a single `list` operation will only ever return documents with a uniform security context.
 * - No User Enumeration: Listing users or teachers from their root collections (`/users`, `/teachers`)
 *   is explicitly disallowed to protect user privacy.
 * - Secure Group Creation: Students are empowered to create their own groups, but the rules enforce
 *   that the creating student must designate themselves as the group leader (`leaderId`) and a member.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the current user's UID matches the provided userId.
     * This is the foundation for ownership-based security.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if a document exists and if the current user is the owner.
     * Used for safe update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Checks if the currently authenticated user has an admin role.
     * Roles are determined by the existence of a document in the /roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * Checks if the currently authenticated user has a teacher role.
     */
    function isTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_teacher/$(request.auth.uid));
    }

    /**
     * Checks if the currently authenticated user has a student role.
     */
    function isStudent() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_student/$(request.auth.uid));
    }

    /**
     * Checks if the user is a member or the designated teacher of a specific group.
     * Requires a 'get' call to the parent group document.
     */
    function isGroupParticipant(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return isSignedIn() && (request.auth.uid == group.teacherId || request.auth.uid in group.memberIds);
    }
    
    /**
     * Checks if the user is the designated teacher of a specific group.
     */
    function isGroupTeacher(groupId) {
        let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
        return isSignedIn() && request.auth.uid == group.teacherId;
    }
    
    /**
     * Checks if the user is the leader of a specific group.
     * NOTE: This function reads the *existing* document and is for update/delete checks.
     */
    function isExistingGroupLeader() {
        return resource != null && isOwner(resource.data.leaderId);
    }

    /**
     * Checks if a user is a participant in a session chat.
     * CRITICAL: This requires that the session document at /session_chats/{sessionId}
     * contains a denormalized array `participantIds` of all member UIDs.
     */
    function isSessionParticipant(sessionId) {
      let session = get(/databases/$(database)/documents/session_chats/$(sessionId)).data;
      return isSignedIn() && request.auth.uid in session.participantIds;
    }
    
    // -------------------------------------------------------------------------
    // Role Definitions (/roles_*)
    // -------------------------------------------------------------------------

    /**
     * @description Manages administrator roles. Only existing admins can read or write these roles.
     * @path /roles_admin/{adminId}
     * @allow An admin (create) their own role document initially (or have another admin do it).
     * @deny A non-admin user (get) the list of admins.
     * @principle Secures role management to prevent privilege escalation.
     */
    match /roles_admin/{adminId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    /**
     * @description Manages teacher roles. Only admins can assign or revoke teacher status.
     * @path /roles_teacher/{teacherId}
     * @allow An admin (create) a document to grant a user teacher privileges.
     * @deny A teacher (delete) their own role document.
     * @principle Centralizes role management under administrators.
     */
    match /roles_teacher/{teacherId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    /**
     * @description Manages student roles. Only admins can assign or revoke student status.
     * @path /roles_student/{studentId}
     * @allow An admin (create) a document to grant a user student privileges.
     * @deny A student (create) their own role document.
     * @principle Centralizes role management under administrators.
     */
    match /roles_student/{studentId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Public and Profile Collections
    // -------------------------------------------------------------------------

    /**
     * @description Publicly readable academic department information. Writable only by admins.
     * @path /departments/{departmentId}
     * @allow Any user, even unauthenticated (get) a department's details.
     * @deny A teacher (create) a new department document.
     * @principle Provides public read access for foundational data while securing writes.
     */
    match /departments/{departmentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description User (student) profile data. Users can create and manage their own profile.
     * @path /users/{userId}
     * @allow A user (create) their own profile document, where the document ID matches their UID.
     * @deny A user (update) another user's profile.
     * @principle Enforces strict data ownership for user-specific information.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Prevent user enumeration
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false; // Profiles are generally not user-deletable
    }

    /**
     * @description Teacher profile data. Teachers can manage their own profile. Admins have full access.
     * @path /teachers/{teacherId}
     * @allow A teacher (update) their own profile document.
     * @deny A student (get) a teacher's profile.
     * @principle Enforces data ownership, with admin override for management.
     */
    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId) || isAdmin();
      allow list: if false; // Prevent teacher enumeration
      allow create: if (isOwner(teacherId) && request.resource.data.id == teacherId) || isAdmin();
      allow update: if (isExistingOwner(teacherId) && request.resource.data.id == resource.data.id) || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Core: Groups and Subcollections
    // -------------------------------------------------------------------------
    
    /**
     * @description Collaborative group documents. Access is determined by `memberIds` and `teacherId`.
     * @path /groups/{groupId}
     * @allow A student (create) a new group, setting themselves as the leader.
     * @deny A user not in `memberIds` (get) the group details.
     * @principle Implements a "Shared Access" model using a denormalized list of participants.
     */
    match /groups/{groupId} {
      allow get: if isGroupParticipant(groupId) || isAdmin();
      allow list: if isSignedIn(); // Requires client-side query filtering (e.g., where('memberIds', 'array-contains', uid))
      allow create: if isStudent() && request.resource.data.leaderId == request.auth.uid && request.auth.uid in request.resource.data.memberIds;
      allow update: if resource != null && (isOwner(resource.data.leaderId) || isOwner(resource.data.teacherId) || isAdmin()) && request.resource.data.leaderId == resource.data.leaderId;
      allow delete: if resource != null && (isOwner(resource.data.teacherId) || isAdmin());
    }

    /**
     * @description Project proposals submitted by a group. Access is inherited from the parent group.
     * @path /groups/{groupId}/proposals/{proposalId}
     * @allow A group member (create) a proposal for their group.
     * @deny A student from another group (get) this proposal.
     * @principle Secures subcollection data based on parent document's authorization logic.
     */
    match /groups/{groupId}/proposals/{proposalId} {
      allow get, list: if isGroupParticipant(groupId) || isAdmin();
      allow create: if isGroupParticipant(groupId);
      allow update, delete: if resource != null && (isGroupTeacher(groupId) || isExistingGroupLeader() || isAdmin());
    }

    /**
     * @description Attendance records for group members. Access is inherited from the parent group.
     * @path /groups/{groupId}/attendance/{attendanceId}
     * @allow The group's teacher (create) an attendance record for a student in the group.
     * @deny A student (create) their own attendance record.
     * @principle Secures subcollection data based on parent document's authorization logic.
     */
    match /groups/{groupId}/attendance/{attendanceId} {
      allow get, list: if isGroupParticipant(groupId) || isAdmin();
      allow create, update, delete: if resource != null && (isGroupTeacher(groupId) || isAdmin());
    }

    /**
     * @description Tasks assigned within a group. Access is inherited from the parent group.
     * @path /groups/{groupId}/tasks/{taskId}
     * @allow Any group member (create) a new task for the group.
     * @deny A student from another group (list) the tasks.
     * @principle Secures subcollection data based on parent document's authorization logic.
     */
    match /groups/{groupId}/tasks/{taskId} {
      allow get, list, create: if isGroupParticipant(groupId) || isAdmin();
      allow update, delete: if resource != null && (isGroupParticipant(groupId) || isAdmin());
    }
    
    /**
     * @description Evaluations of students within a group, managed by the teacher.
     * @path /groups/{groupId}/evaluations/{evaluationId}
     * @allow The group teacher (create) an evaluation for a group member.
     * @deny A student (update) another student's evaluation.
     * @principle Restricts sensitive write operations to authorized roles (teacher/admin).
     */
    match /groups/{groupId}/evaluations/{evaluationId} {
      allow get, list: if isGroupParticipant(groupId) || isAdmin();
      allow create, update, delete: if resource != null && (isGroupTeacher(groupId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Chat Collections
    // -------------------------------------------------------------------------
    
    /**
     * @description Global chat messages for communication between admins and teachers.
     * @path /global_chat/{chatMessageId}
     * @allow A teacher (create) a new message in the global chat.
     * @deny A student (get) any message from the global chat.
     * @principle Restricts access to specific roles for system-wide communication channels.
     */
    match /global_chat/{chatMessageId} {
      allow get, list, create: if isTeacher() || isAdmin();
      allow update, delete: if false; // Messages are immutable
    }

    /**
     * @description Represents the parent document for a group chat. Rules are on the messages subcollection.
     * @path /group_chats/{groupId}
     * @allow No direct access is allowed to this document.
     * @deny Any operation.
     * @principle Acts as a namespace for the messages subcollection.
     */
    match /group_chats/{groupId} {
      allow read, write: if false;
    }

    /**
     * @description Chat messages within a specific group. Access is granted to group participants.
     * @path /group_chats/{groupId}/messages/{chatMessageId}
     * @allow A group member (create) a new message in their group's chat.
     * @deny A teacher of a different group (list) these messages.
     * @principle Inherits access permissions by checking membership in the corresponding `/groups` document.
     */
    match /group_chats/{groupId}/messages/{chatMessageId} {
      allow get, list, create: if isGroupParticipant(groupId) || isAdmin();
      allow update, delete: if false; // Messages are immutable
    }

    /**
     * @description Represents the parent document for a session chat. Holds participant list.
     * @path /session_chats/{sessionId}
     * @allow No direct access is allowed to this document.
     * @deny Any operation.
     * @principle Acts as a namespace and data source for the messages subcollection.
     *           // TODO: Ensure this document contains a 'participantIds' array field.
     */
    match /session_chats/{sessionId} {
      allow read, write: if false;
    }

    /**
     * @description Chat messages within a live session.
     * @path /session_chats/{sessionId}/messages/{chatMessageId}
     * @allow A session participant (create) a message.
     * @deny A user not in the session (get) a message.
     * @principle Secures access by checking a denormalized participant list on the parent session document.
     */
    match /session_chats/{sessionId}/messages/{chatMessageId} {
      // CRITICAL: This rule assumes the parent document /session_chats/{sessionId} contains an
      // array field `participantIds` with the UIDs of all members.
      allow get, list, create: if isSessionParticipant(sessionId) || isAdmin();
      allow update, delete: if false; // Messages are immutable
    }
  }
}